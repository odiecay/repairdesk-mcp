# Copy this file's values into your MCP client's "env" block for this server —
# most clients (Claude Code, Claude Desktop) do not read a .env file directly.

# Required unless using an access token — your RepairDesk API key (Settings > API)
REPAIRDESK_API_KEY=YOUR_REPAIRDESK_API_KEY_HERE

# Optional — override if your store uses a different API base URL
REPAIRDESK_BASE_URL=https://api.repairdesk.co/api/web/v1

# Optional — default 1250ms, approximately 48 requests/minute.
# Updated processes sharing the state directory coordinate requests automatically.
REPAIRDESK_MIN_INTERVAL_MS=1250
REPAIRDESK_TIMEOUT_MS=60000

# Optional — externally managed OAuth token; takes precedence over API key.
# Token refresh/consent is handled outside the MCP server.
# REPAIRDESK_ACCESS_TOKEN=

# Optional — permitted upload directories (server-side paths).
# Separate roots with : on Linux/macOS or ; on Windows. Empty disables uploads.
# REPAIRDESK_UPLOAD_ROOTS=/srv/quotes:/srv/job-evidence

# Optional — the User-Agent sent with every RepairDesk API request. RepairDesk's
# Cloudflare blocks default Node/Python UAs, so this must be a non-empty string,
# but it can be anything — your shop name, your own tool's name, etc.
REPAIRDESK_USER_AGENT=YourShopName-MCP/1.0

# Optional — where to write mcp_audit.log. Unset: logs next to server.mjs.
# An explicitly configured relative path is relative to the process working directory.
REPAIRDESK_LOG_DIR=./logs

# Default: use documented API status writes with status/notification readback.
# Known upstream issue: automatic notifications can contain unresolved macros.
# Optional "web" blocks status writes; it is not the standard MCP workflow.
REPAIRDESK_STATUS_MODE=api

# Optional — shared pacing timestamps (default: ~/.cache/repairdesk-mcp).
# REPAIRDESK_STATE_DIR=/srv/repairdesk-mcp-state
